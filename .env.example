# Dispo-Concept — environment template (placeholders only; never commit real values)
# Copy to .env and fill in production values.

# SQLite database location (relative to src/lib). Production: plan managed PostgreSQL (blueprint §23.4).
DATABASE_URL="file:../db/custom.db"

# High-entropy salt used to hash requester network keys (never store raw IPs).
# Generate: openssl rand -hex 32
RFQ_IP_SALT="replace-with-unique-high-entropy-salt"

# Canonical production origin used for metadata, canonical URLs, OG tags and JSON-LD.
NEXT_PUBLIC_SITE_URL="https://dispoconceptpvtltd.com"

# Google reCAPTCHA v3 — public site key (browser) + secret (server-side verify).
# When both are set, RFQ and chat endpoints enforce score >= 0.5 verification,
# the token's action ("rfq_submit" / "chat_message") and, when set below, the
# token's hostname. Leave empty to disable reCAPTCHA; honeypot, rate limiting
# and same-origin checks remain active in every mode.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
# Optional but recommended in production: reject tokens earned on a different
# origin (e.g. "dispoconceptpvtltd.com"). Empty = hostname not checked.
RECAPTCHA_EXPECTED_HOSTNAME=""
